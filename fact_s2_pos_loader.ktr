<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>fact_s2_pos_loader</name>
    <description>Memuat Transaksi 42 Toko Fisik (S2) ke fact_penjualan</description>
    <trans_version>1.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
  </info>
  <connection>
    <name>nrg_dw_mysql</name>
    <server>localhost</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>nrg_dw</database>
    <port>3306</port>
    <username>root</username>
    <password></password>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>3306</attribute></attribute>
      <attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>STREAM_RESULTS</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>Input POS Trx Lines</from><to>Lookup Header Data</to><enabled>Y</enabled></hop>
    <hop><from>Input POS Trx Headers</from><to>Filter VOID Headers</to><enabled>Y</enabled></hop>
    <hop><from>Filter VOID Headers</from><to>Lookup Header Data</to><enabled>Y</enabled></hop>
    <hop><from>Lookup Header Data</from><to>Filter Non-VOID Lines</to><enabled>Y</enabled></hop>
    <hop><from>Filter Non-VOID Lines</from><to>Transform POS Metrics</to><enabled>Y</enabled></hop>
    <hop><from>Transform POS Metrics</from><to>Lookup S4 COGS S2</to><enabled>Y</enabled></hop>
    <hop><from>Lookup S4 COGS S2</from><to>Lookup Toko S2</to><enabled>Y</enabled></hop>
    <hop><from>Lookup Toko S2</from><to>Calculate Margin S2</to><enabled>Y</enabled></hop>
    <hop><from>Calculate Margin S2</from><to>Insert Fact Penjualan S2</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Input POS Trx Lines</name>
    <type>TextFileInput</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <accept_filenames>N</accept_filenames>
    <passing_through_fields>N</passing_through_fields>
    <accept_field/>
    <accept_stepname/>
    <separator>;</separator>
    <enclosure>&quot;</enclosure>
    <enclosure_breaks>N</enclosure_breaks>
    <escapechar/>
    <header>Y</header>
    <nr_headerlines>1</nr_headerlines>
    <footer>N</footer>
    <nr_footerlines>1</nr_footerlines>
    <line_wrapped>N</line_wrapped>
    <nr_wraps>1</nr_wraps>
    <layout_paged>N</layout_paged>
    <nr_lines_per_page>80</nr_lines_per_page>
    <nr_lines_doc_header>0</nr_lines_doc_header>
    <noempty>Y</noempty>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <rownumByFile>N</rownumByFile>
    <rownum_field/>
    <format>mixed</format>
    <encoding>UTF-8</encoding>
    <add_to_result_filenames>N</add_to_result_filenames>
    <file>
      <name>${Internal.Transformation.Filename.Directory}/Data/S2_POS_TOKO</name>
      <filemask>trx_line_TS.*\.csv</filemask>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
      <type>CSV</type>
      <compression>None</compression>
    </file>
    <filters/>
    <fields>
      <field>
        <name>trx_no</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>line_seq</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>item_code</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>qty</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>unit_price_excl</name>
        <type>Number</type>
        <format/>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>disc_pct</name>
        <type>Number</type>
        <format/>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <error_ignored>N</error_ignored>
    <skip_bad_files>N</skip_bad_files>
    <file_error_field/>
    <file_error_message_field/>
    <error_line_skipped>N</error_line_skipped>
    <error_count_field/>
    <error_fields_field/>
    <error_text_field/>
    <bad_line_files_destination_directory/>
    <bad_line_files_extension>warning</bad_line_files_extension>
    <error_line_files_destination_directory/>
    <error_line_files_extension>error</error_line_files_extension>
    <line_number_files_destination_directory/>
    <line_number_files_extension>line</line_number_files_extension>
    <date_format_lenient>Y</date_format_lenient>
    <date_format_locale>en_US</date_format_locale>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <GUI><xloc>100</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>

  <step>
    <name>Input POS Trx Headers</name>
    <type>TextFileInput</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <accept_filenames>N</accept_filenames>
    <passing_through_fields>N</passing_through_fields>
    <accept_field/>
    <accept_stepname/>
    <separator>;</separator>
    <enclosure>&quot;</enclosure>
    <enclosure_breaks>N</enclosure_breaks>
    <escapechar/>
    <header>Y</header>
    <nr_headerlines>1</nr_headerlines>
    <footer>N</footer>
    <nr_footerlines>1</nr_footerlines>
    <line_wrapped>N</line_wrapped>
    <nr_wraps>1</nr_wraps>
    <layout_paged>N</layout_paged>
    <nr_lines_per_page>80</nr_lines_per_page>
    <nr_lines_doc_header>0</nr_lines_doc_header>
    <noempty>Y</noempty>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <rownumByFile>N</rownumByFile>
    <rownum_field/>
    <format>mixed</format>
    <encoding>UTF-8</encoding>
    <add_to_result_filenames>N</add_to_result_filenames>
    <file>
      <name>${Internal.Transformation.Filename.Directory}/Data/S2_POS_TOKO</name>
      <filemask>trx_header_TS.*\.csv</filemask>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
      <type>CSV</type>
      <compression>None</compression>
    </file>
    <filters/>
    <fields>
      <field>
        <name>h_trx_no</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>store_code</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>cashier_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>member_no</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>trx_date</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>payment_type</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>status</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>-</nullif>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <error_ignored>N</error_ignored>
    <skip_bad_files>N</skip_bad_files>
    <file_error_field/>
    <file_error_message_field/>
    <error_line_skipped>N</error_line_skipped>
    <error_count_field/>
    <error_fields_field/>
    <error_text_field/>
    <bad_line_files_destination_directory/>
    <bad_line_files_extension>warning</bad_line_files_extension>
    <error_line_files_destination_directory/>
    <error_line_files_extension>error</error_line_files_extension>
    <line_number_files_destination_directory/>
    <line_number_files_extension>line</line_number_files_extension>
    <date_format_lenient>Y</date_format_lenient>
    <date_format_locale>en_US</date_format_locale>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <GUI><xloc>100</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>

  <step>
    <name>Filter VOID Headers</name>
    <type>FilterRows</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Lookup Header Data</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>status</leftvalue>
        <function>&lt;&gt;</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>VOID</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <GUI><xloc>260</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>

  <step>
    <name>Lookup Header Data</name>
    <type>StreamLookup</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <from>Filter VOID Headers</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key><name>trx_no</name><field>h_trx_no</field></key>
      <value><name>store_code</name><rename>store_code</rename><default/></value>
      <value><name>member_no</name><rename>member_no</rename><default/></value>
      <value><name>trx_date</name><rename>trx_date</rename><default/></value>
    </lookup>
    <GUI><xloc>260</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>

  <step>
    <name>Filter Non-VOID Lines</name>
    <type>FilterRows</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Transform POS Metrics</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>store_code</leftvalue>
        <function>IS NOT NULL</function>
      </condition>
    </compare>
    <GUI><xloc>420</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>

  <step>
    <name>Transform POS Metrics</name>
    <type>ScriptValueMod</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
var p = trx_date.split("/");
var sk_waktu = java.lang.Integer.parseInt(p[2] + p[1] + p[0]);

var u_price_excl = unit_price_excl;
var gross_excl = Math.round((qty * u_price_excl) * 100) / 100;
var d_excl = Math.round((gross_excl * (disc_pct / 100.0)) * 100) / 100;
var net_excl = Math.round((gross_excl - d_excl) * 100) / 100;

var kanal = "TOKO_FISIK";
var mat_no = item_code;
        </jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>sk_waktu</name><rename>sk_waktu</rename><type>Integer</type></field>
      <field><name>u_price_excl</name><rename>harga_satuan_excl</rename><type>Number</type></field>
      <field><name>gross_excl</name><rename>nilai_kotor_excl</rename><type>Number</type></field>
      <field><name>d_excl</name><rename>nilai_diskon_excl</rename><type>Number</type></field>
      <field><name>net_excl</name><rename>nilai_bersih_excl</rename><type>Number</type></field>
      <field><name>kanal</name><rename>kanal</rename><type>String</type></field>
      <field><name>mat_no</name><rename>material_no</rename><type>String</type></field>
    </fields>
    <GUI><xloc>580</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>

  <step>
    <name>Lookup S4 COGS S2</name>
    <type>DBLookup</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>nrg_dw_mysql</connection>
    <cache>Y</cache>
    <cache_size>1000</cache_size>
    <lookup>
      <schema/>
      <table>dim_produk</table>
      <key><name>material_no</name><field>material_no</field><condition>=</condition></key>
      <value><name>sk_produk</name><rename>sk_produk</rename><default>1</default><type>Integer</type></value>
      <value><name>harga_pokok_terkini</name><rename>harga_pokok_satuan</rename><default>0</default><type>Number</type></value>
    </lookup>
    <GUI><xloc>720</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>

  <step>
    <name>Lookup Toko S2</name>
    <type>DBLookup</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>nrg_dw_mysql</connection>
    <cache>Y</cache>
    <cache_size>100</cache_size>
    <lookup>
      <schema/>
      <table>dim_toko_kanal</table>
      <key><name>store_code</name><field>kode_toko_kanal</field><condition>=</condition></key>
      <value><name>sk_toko_kanal</name><rename>sk_toko_kanal</rename><default>1</default><type>Integer</type></value>
    </lookup>
    <GUI><xloc>840</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>

  <step>
    <name>Calculate Margin S2</name>
    <type>ScriptValueMod</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
var total_cogs = Math.round((qty * harga_pokok_satuan) * 100) / 100;
var fee_komisi = 0.00;
var margin_kotor = Math.round((nilai_bersih_excl - total_cogs - fee_komisi) * 100) / 100;
var sk_promosi = 1;
var sk_pelanggan = 2345; // Default ID pelanggan toko non-member / member
        </jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>total_cogs</name><rename>total_harga_pokok</rename><type>Number</type></field>
      <field><name>fee_komisi</name><rename>fee_komisi</rename><type>Number</type></field>
      <field><name>margin_kotor</name><rename>margin_kotor</rename><type>Number</type></field>
      <field><name>sk_promosi</name><rename>sk_promosi</rename><type>Integer</type></field>
      <field><name>sk_pelanggan</name><rename>sk_pelanggan</rename><type>Integer</type></field>
    </fields>
    <GUI><xloc>960</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>

  <step>
    <name>Insert Fact Penjualan S2</name>
    <type>TableOutput</type>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>nrg_dw_mysql</connection>
    <schema/>
    <table>fact_penjualan</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <fields>
      <field><column_name>sk_waktu</column_name><stream_name>sk_waktu</stream_name></field>
      <field><column_name>sk_produk</column_name><stream_name>sk_produk</stream_name></field>
      <field><column_name>sk_toko_kanal</column_name><stream_name>sk_toko_kanal</stream_name></field>
      <field><column_name>sk_pelanggan</column_name><stream_name>sk_pelanggan</stream_name></field>
      <field><column_name>sk_promosi</column_name><stream_name>sk_promosi</stream_name></field>
      <field><column_name>no_transaksi</column_name><stream_name>trx_no</stream_name></field>
      <field><column_name>line_no</column_name><stream_name>line_seq</stream_name></field>
      <field><column_name>kanal</column_name><stream_name>kanal</stream_name></field>
      <field><column_name>qty</column_name><stream_name>qty</stream_name></field>
      <field><column_name>harga_satuan_excl</column_name><stream_name>harga_satuan_excl</stream_name></field>
      <field><column_name>nilai_kotor_excl</column_name><stream_name>nilai_kotor_excl</stream_name></field>
      <field><column_name>nilai_diskon_excl</column_name><stream_name>nilai_diskon_excl</stream_name></field>
      <field><column_name>nilai_bersih_excl</column_name><stream_name>nilai_bersih_excl</stream_name></field>
      <field><column_name>harga_pokok_satuan</column_name><stream_name>harga_pokok_satuan</stream_name></field>
      <field><column_name>total_harga_pokok</column_name><stream_name>total_harga_pokok</stream_name></field>
      <field><column_name>fee_komisi</column_name><stream_name>fee_komisi</stream_name></field>
      <field><column_name>margin_kotor</column_name><stream_name>margin_kotor</stream_name></field>
    </fields>
    <GUI><xloc>1100</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
</transformation>
